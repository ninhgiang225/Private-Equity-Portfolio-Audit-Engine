# ── LLM ──────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Web search (choose one) ───────────────────────
TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=...

# ── Langfuse observability ────────────────────────
# Get these from https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# ── BigQuery (optional for Week 1-3) ─────────────
# Point to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/bq-service-account.json
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=pe_pipeline

# ── Pipeline config ───────────────────────────────
JUDGE_ACCEPT_THRESHOLD=7      # scores >= this are auto-accepted
JUDGE_REVIEW_THRESHOLD=4      # scores < this are rejected; 4-6 go to review
BATCH_SIZE=10                 # companies per batch (avoids rate limits)
